{
  "name": "lotovantagem",
  "version": "1.0.0",
  "description": "Aplicativo de Avaliação do Retorno Médio das Loterias Caixa em Vite + React",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server.js",
    "build:exe": "vite build && npx @yao-pkg/pkg . --targets host --output dist/LotoVantagem.exe"
  },
  "pkg": {
    "assets": [
      "dist/client/**/*",
      "public/**/*",
      "lot.json"
    ],
    "outputPath": "dist"
  },
  "keywords": [],
